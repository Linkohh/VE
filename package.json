{
  "name": "vibeme",
  "version": "1.0.0",
  "description": "A beautiful motivational quote generator with dynamic themes and inspiring messages",
  "main": "dist/main.js",
  "scripts": {
    "sync-quotes": "node scripts/sync-quotes.js",
    "build:styles": "sass --no-source-map src/scss/main.scss css/style.css",
    "watch:styles": "sass --watch --no-source-map src/scss/main.scss css/style.css",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "keywords": [
    "quotes",
    "motivation",
    "inspiration"
  ],
  "author": "VibeMe",
  "license": "ISC",
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.2",
    "sass": "^1.93.0",
    "typescript": "^5.4.5",
    "vite": "^5.4.1"
  }
}
